@page "/chat"
@using Yodaphone.Web.Components.Chat
@using Yodaphone.Web.Domain
@using Yodaphone.Web.Services
@using Yodaphone.Web.Chat.Agents
@using DomainMessage = Yodaphone.Web.Domain.ChatMessage
@implements IDisposable
@inject IChatService ChatService
@inject ILogger<Chat> Logger

<PageTitle>YodaPhone AI — Chat</PageTitle>

<div class="yp-shell @(_darkMode ? "dark" : "")">

    <header class="yp-header">
        <div class="yp-header__brand">
            <span class="yp-logo" aria-hidden="true">YP</span>
            <span class="yp-brand-name">YodaPhone <em>AI</em></span>
        </div>

        <button class="yp-btn yp-btn--ghost yp-header__new-chat" @onclick="StartNewChat" disabled="@_isBusy">
            New chat
        </button>

        <div class="yp-header__spacer"></div>

        <div class="yp-header__user">
            <span class="yp-header__user-label">@UserName</span>
            <span class="yp-avatar" aria-hidden="true">@UserInitial</span>
        </div>
    </header>

    <div class="yp-body">
        <Sidebar DarkMode="_darkMode" OnDarkModeToggled="ToggleDarkMode" OnHelpRequested="ShowHelp" />

        <main class="yp-main">
            <ChatWindow Messages="_messages" PendingMessage="@_pendingMessage" IsBotTyping="_isWaitingForReply" />

            @if (_errorMessage is not null)
            {
                <div class="yp-chat-error" role="alert">@_errorMessage</div>
            }

            <ChatInput OnMessageSent="HandleUserMessageSent" IsSending="@(_isBusy || _conversation is null)" />
        </main>
    </div>
</div>

@code {
    private const string UserName = "Alex Rivera";
    private string UserInitial => string.IsNullOrWhiteSpace(UserName) ? "?" : UserName[0].ToString();

    private Conversation? _conversation;
    private IReadOnlyCollection<DomainMessage> _messages = Array.Empty<DomainMessage>();
    private readonly CancellationTokenSource _lifetime = new();
    private string? _pendingMessage;
    private string? _errorMessage;
    private bool _darkMode;
    private bool _isBusy;
    private bool _isWaitingForReply;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _conversation = await ChatService.GetActiveConversationAsync(_lifetime.Token);
            if (_conversation is not null)
            {
                _messages = _conversation.Messages.ToArray();
                return;
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Could not restore the active conversation");
            _errorMessage = "Your previous conversation could not be restored.";
        }

        await StartNewChat();
    }

    private Task HandleUserMessageSent(string text)
    {
        if (string.IsNullOrWhiteSpace(text) || _conversation is null)
        {
            return Task.CompletedTask;
        }

        var conversationId = _conversation.Id.ToString();
        return RunConversationOperation(
            async () => { await ChatService.SendMessageAsync(conversationId, text.Trim(), _lifetime.Token); },
            "Your message could not be completed. Please try again.",
            pendingMessage: text.Trim());
    }

    private Task StartNewChat() => RunConversationOperation(async () =>
    {
        if (_conversation is not null)
        {
            await ChatService.CloseConversationAsync(_conversation.Id.ToString(), _lifetime.Token);
            _conversation = null;
            _messages = Array.Empty<DomainMessage>();
        }

        _conversation = await ChatService.StartConversationAsync(_lifetime.Token);
        await ChatService.AddMessageAsync(
            _conversation.Id.ToString(), MessageRole.Assistant,
            "Hello! I'm YodaPhone AI. How can I help with your account today?", _lifetime.Token);
    }, "A new chat could not be started. Please try again.");

    private void ToggleDarkMode()
    {
        _darkMode = !_darkMode;
    }

    private Task ShowHelp()
    {
        if (_conversation is null)
        {
            return Task.CompletedTask;
        }

        var conversationId = _conversation.Id.ToString();
        return RunConversationOperation(async () =>
        {
            await ChatService.AddMessageAsync(
                conversationId, MessageRole.Assistant,
                "Need help? Ask me about billing, plans, device support or outages — or type \"agent\" to reach a human specialist.",
                _lifetime.Token);
        }, "Help could not be displayed. Please try again.");
    }

    private async Task RunConversationOperation(Func<Task> operation, string errorMessage, string? pendingMessage = null)
    {
        if (_isBusy || _disposed)
        {
            return;
        }

        _isBusy = true;
        _isWaitingForReply = pendingMessage is not null;
        _pendingMessage = pendingMessage;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            await operation();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
            // The page was closed while an operation was running.
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Chat operation failed");
            _errorMessage = exception is ChatAgentException ? exception.Message : errorMessage;
        }
        finally
        {
            if (!_disposed)
            {
                try
                {
                    if (_conversation is not null)
                    {
                        // Refresh after failures too: the service retains a customer
                        // message when the agent fails. A snapshot avoids showing it
                        // twice alongside the temporary pending bubble.
                        _conversation = await ChatService.GetConversationAsync(_conversation.Id.ToString(), _lifetime.Token);
                        _messages = _conversation.Messages.ToArray();
                    }
                }
                catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
                {
                }
                catch (Exception exception)
                {
                    Logger.LogWarning(exception, "Could not refresh the conversation");
                    _errorMessage ??= "The conversation could not be refreshed. Please try again.";
                }

                _pendingMessage = null;
                _isBusy = false;
                _isWaitingForReply = false;
            }
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
