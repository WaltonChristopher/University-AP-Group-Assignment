@using Yodaphone.Web.Domain
@using DomainMessage = Yodaphone.Web.Domain.ChatMessage

<div class="yp-message-row @(IsFromAgent ? "yp-message-row--bot" : "yp-message-row--user")">
    <div class="yp-bubble @(IsFromAgent ? "yp-bubble--bot" : "yp-bubble--user")">
        <span class="yp-bubble__sender">@(IsFromAgent ? "YodaPhone AI" : "You")</span>
        <p class="yp-bubble__content">@(Message?.Content ?? PendingContent)</p>
        <div class="yp-bubble__meta">
            @if (Message is not null)
            {
                <span>@Message.SentAt.ToLocalTime().ToString("h:mm tt")</span>
            }
            @if (PendingContent is not null)
            {
                <span class="yp-bubble__status">Sending…</span>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public DomainMessage? Message { get; set; }
    [Parameter] public string? PendingContent { get; set; }

    private bool IsFromAgent => Message?.Role == MessageRole.Assistant;
}
