<mxfile host="app.diagrams.net" agent="Yodaphone UML documentation" version="24.7.17" compressed="false"><diagram id="06-copilot-fallback-activity" name="6. Copilot fallback activity diagram"><mxGraphModel dx="1760" dy="2050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="2050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="6. Copilot fallback activity diagram" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=27;fontColor=#334155;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1680" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="IChatAgent = CopilotFallbackChatAgent when Chat:Agent is copilot. State lasts for the scoped session / Blazor circuit." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1680" height="50" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;html=0;whiteSpace=wrap;fillColor=#475569;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="810" y="145" width="28" height="28" as="geometry"/></mxCell><mxCell id="validate" value="ChatAgentBase.GetReplyAsync&#10;Validate history and cancellation" style="rounded=1;arcSize=15;html=0;whiteSpace=wrap;fillColor=#e5f5ed;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="635" y="220" width="380" height="90" as="geometry"/></mxCell><mxCell id="valid" value="Valid request?" style="rhombus;html=0;whiteSpace=wrap;fillColor=#e5f5ed;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="710" y="365" width="230" height="110" as="geometry"/></mxCell><mxCell id="invalid" value="Throw validation / cancellation error&#10;Keep session mode" style="rounded=1;arcSize=15;html=0;whiteSpace=wrap;fillColor=#fffbe8;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="375" width="420" height="100" as="geometry"/></mxCell><mxCell id="mode" value="offlineMode?" style="rhombus;html=0;whiteSpace=wrap;fillColor=#e5f5ed;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="710" y="550" width="230" height="110" as="geometry"/></mxCell><mxCell id="request" value="Create linked cancellation token&#10;CancelAfter(responseTimeout)&#10;await copilotAgent.GetReplyAsync(...).WaitAsync(token)" style="rounded=1;arcSize=15;html=0;whiteSpace=wrap;fillColor=#e5f5ed;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="500" y="740" width="650" height="110" as="geometry"/></mxCell><mxCell id="success" value="Request returned&#10;a valid reply?" style="rhombus;html=0;whiteSpace=wrap;fillColor=#e5f5ed;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="690" y="935" width="270" height="130" as="geometry"/></mxCell><mxCell id="caller" value="Caller cancelled?" style="rhombus;html=0;whiteSpace=wrap;fillColor=#e5f5ed;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1210" y="945" width="260" height="110" as="geometry"/></mxCell><mxCell id="cancel" value="Throw OperationCanceledException&#10;Keep session mode" style="rounded=1;arcSize=15;htm