y as="points"><mxPoint x="485" y="1710"/><mxPoint x="655" y="1710"/></Array></mxGeometry></mxCell><mxCell id="edge-15-label" value="[caller still active]" vertex="1" connectable="0" parent="edge-15" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#334155;fillColor=#ffffff;strokeColor=none;"><mxGeometry x="-1" y="0" width="169.4" height="21" relative="1" as="geometry"><mxPoint x="-179.7" y="349.5" as="offset"/></mxGeometry></mxCell><mxCell id="edge-16" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;strokeColor=#475569;strokeWidth=1.5;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="check" target="cancel"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="195" y="1200"/><mxPoint x="195" y="1338"/><mxPoint x="1640" y="1338"/><mxPoint x="1640" y="1205"/></Array></mxGeometry></mxCell><mxCell id="edge-16-label" value="[caller cancelled]" vertex="1" connectable="0" parent="edge-16" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#334155;fillColor=#ffffff;strokeColor=none;"><mxGeometry x="-1" y="0" width="147.20000000000002" height="21" relative="1" as="geometry"><mxPoint x="561.4" y="127.5" as="offset"/></mxGeometry></mxCell><mxCell id="edge-17" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;strokeColor=#475569;strokeWidth=1.5;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="offline" target="return"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="1715"/><mxPoint x="1130" y="1715"/><mxPoint x="1130" y="1815"/></Array></mxGeometry></mxCell><mxCell id="edge-18" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;strokeColor=#475569;strokeWidth=1.5;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="return" target="end"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="655.0" y="1895.0"/><mxPoint x="657.0" y="1895.0"/></Array></mxGeometry></mxCell><mxCell id="screening-note" value="Inside GitHubCopilotAgent.GetReplyAsync:&#10;Start a fresh client → create session → send&#10;  transcript → dispose session, then client.&#10;ChatAgentBase checks the returned content. A&#10;  forbidden reply becomes a fixed explanation and&#10;  counts as a valid reply, so Copilot mode&#10;  remains active.&#10;SDK errors become ChatAgentException; missing or&#10;  blank content is rejected." style="shape=note;size=16;html=0;whiteSpace=wrap;fillColor=#fffbe8;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="390" height="300" as="geometry"/></mxCell><mxCell id="state-note" value="A new scoped session starts with offlineMode = false.&#10;Caller cancellation propagates without changing mode.&#10;Timeout applies to startup, send, and cleanup; late provider&#10;  results are discarded." style="shape=note;size=16;html=0;whiteSpace=wrap;fillColor=#fffbe8;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1160" y="710" width="500" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
