k activity diagram" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=27;fontColor=#334155;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1680" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="IChatAgent = CopilotFallbackChatAgent when Chat:Agent is copilot. State lasts for the scoped session / Blazor circuit." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1680" height="50" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;html=0;whiteSpace=wrap;fillColor=#475569;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="810" y="145" width="28" height="28" as="geometry"/></mxCell><mxCell id="validate" value="ChatAgentBase.GetReplyAsync&#10;Validate history and cancellation" style="rounded=1;arcSize=15;html=0;whiteSpace=wrap;fillColor=#e5f5ed;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="635" y="220" width="380" height="90" as="geometry"/></mxCell><mxCell id="valid" value="Valid request?" style="rhombus;html=0;whiteSpace=wrap;fillColor=#e5f5ed;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="710" y="365" width="230" height="110" as="geometry"/></mxCell><mxCell id="invalid" value="Throw validation / cancellation error&#10;Keep session mode" style="rounded=1;arcSize=15;html=0;whiteSpace=wrap;fillColor=#fffbe8;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="375" width="420" height="100" 