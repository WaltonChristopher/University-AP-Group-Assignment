"notes" value="Tests use real SQLite schema / transactions through SqliteTestDatabase, fake provider client / session interfaces for offline Copilot tests, HtmlRenderer for rendered HTML, bUnit for UI events, WebApplicationFactory for host integration, and Playwright for the browser journey.&#10;Multiple qualified names in one box represent distinct small local helpers with the same contract; no shared helper class is implied." style="shape=note;size=16;html=0;whiteSpace=wrap;fillColor=#fffbe8;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="2560" width="2520" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="08-application-persistence-classes" name="8. Combined application and persistence class diagram"><mxGraphModel dx="4240" dy="2440" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4240" pageHeight="2440" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="8. Combined application and persistence class diagram" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=27;fontColor=#334155;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="4160" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Diagrams 1 and 3 integrated into one view: shared classes appear once, with domain-to-entity mapping and database relationships." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="4160" height="50" as="geometry"/></mxCell><mxCell id="domain-package" value="Yodaphone.Web.Domain" style="shape=swimlane;html=0;startSize=38;horizontal=1;collapsible=0;container=0;rounded=0;fillColor