/><mxPoint x="2940" y="2130"/><mxPoint x="2940" y="1584.5"/></Array></mxGeometry></mxCell><mxCell id="edge-47-label" value="creates one context per repository&#10;  operation" vertex="1" connectable="0" parent="edge-47" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#334155;fillColor=#ffffff;strokeColor=none;"><mxGeometry x="-1" y="0" width="265.6" height="38" relative="1" as="geometry"><mxPoint x="827.2" y="162.0" as="offset"/></mxGeometry></mxCell><mxCell id="persistence-mapping" value="Domain.Conversation.Id and Domain.ChatMessage.Id map to entity Id GUIDs; integer ConversationId / MessageId are database keys.&#10;StartedAt → Start and DateTime; LastActivityAt → LastUpdated; ConversationStatus.Closed ↔ Closed.&#10;ChatMessage.Role → Message.Status; Content → MessageContent; SentAt → DateTime in UTC. SenderId references the owner for all message roles.&#10;Each repository operation creates / disposes its own EF Core context. SaveAsync commits atomically and preserves final closure." style="shape=note;size=16;html=0;whiteSpace=wrap;fillColor=#fffbe8;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="2180" width="4160" height="100" as="geometry"/></mxCell><mxCell id="legend" value="+ public   − private   # protected   ~ internal   / derived   «…» stereotype&#10;CT = CancellationToken; method default values and most constructors are omitted. Selected members are shown.&#10;Dashed open arrow = dependency (including «tests»); dashed hollow triangle = interface realization; solid hollow triangle = inheritance.&#10;Solid line = association; filled diamond = composition. Multiplicities are shown beside association ends." style="shape=note;size=16;html=0;whiteSpace=wrap;fillColor=#fffbe8;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeom