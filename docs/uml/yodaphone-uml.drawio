xCell id="mapping" value="Mapping: Domain.Conversation.Id ↔ entity Id (GUID). Integer ConversationId / MessageId&#10;  remain database keys.&#10;StartedAt → Start and DateTime; LastActivityAt → LastUpdated; Closed ↔&#10;  ConversationStatus.Closed.&#10;ChatMessage.Role → Message.Status; Content → MessageContent; SentAt → DateTime in UTC.&#10;SenderId references the owner for Customer, Assistant and System roles; it does not&#10;  identify a separate AI user.&#10;Repository operations create / dispose their own context. SaveAsync commits atomically&#10;  and does not reopen a closed chat." style="shape=note;size=16;html=0;whiteSpace=wrap;fillColor=#fffbe8;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="1255" width="680" height="270" as="geometry"/></mxCell><mxCell id="legend" value="+ public   − private   # protected   ~ internal   / derived   «…» stereotype&#10;CT = CancellationToken; method default values and most constructors are omitted. Selected members are shown.&#10;Dashed open arrow = dependency (including «tests»); dashed hollow triangle = interface realization; solid hollow triangle = inheritance.&#10;Solid line = association; filled diamond = composition. Multiplicities are shown beside association ends." style="shape=note;size=16;html=0;whiteSpace=wrap;fillColor=#fffbe8;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1560" width="1720" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="04-ui-classes" name="4. Blazor UI class diagram"><mxGraphModel dx="2320" dy="1790" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2320" pageHeight="1790" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="4. Blazor UI class diagram" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=27;fontColor=#334155;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="2240" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Razor components compile to classes; associations show rendered children, parameters, callbacks and injected services." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="2240" height="50" as="geometry"/></mxCell><mxCell id="ui-package" value="Yodaphone.Web.Components.Pages / Chat" style="shape=swimlane;html=0;startSize=38;horizontal=1;collapsible=0;container=0;rounded=0;fillColor=#f8fafc;swimlaneFillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#334155;fontSize=17;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="1620" height="1370" as="geometry"/></mxCell><mxCell id="external-package" value="Service / domain / framework dependencies" style="shape=swimlane;html=0;startSize=38;horizontal=1;collapsible=0;container=0;rounded=0;fillColor=#f8fafc;swimlaneFillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#334155;fontSize=17;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1710" y="150" width="570" height="1370" as="geometry"/></mxCell><mxCell id="page" value="" style="rounded=0;html=0;fillColor=#e4f4f7;strokeColor=#475569;strokeWidth=1.4;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="80" y="220" width="840" height="302" as="geometry"/></mxCell><mxCell id="page-title" value="«Razor component»&#10;Chat&#10;Components.Pages" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#0f172a;fontStyle=1;spacing=0;" vertex="1" parent="page"><mxGeometry x="8" y="6" width="824