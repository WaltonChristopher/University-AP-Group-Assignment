versations: DbSet&lt;Data.Entities.Conversation&gt;&#10;+ Messages: DbSet&lt;Data.Entities.Message&gt;" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1e293b;fontStyle=0;spacing=0;" vertex="1" parent="context"><mxGeometry x="10" y="48" width="660" height="53" as="geometry"/></mxCell><mxCell id="context-divider-1" value="" style="line;strokeColor=#64748b;strokeWidth=1;" vertex="1" parent="context"><mxGeometry x="0" y="107" width="680" height="0" as="geometry"/></mxCell><mxCell id="context-body-1" value="# OnModelCreating(modelBuilder): void" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1e293b;fontStyle=0;spacing=0;" vertex="1" parent="context"><mxGeometry x="10" y="113" width="660" height="20" as="geometry"/></mxCell><mxCell id="dbcontext" value="" style="rounded=0;html=0;fillColor=#f1f3f5;strokeColor=#475569;strokeWidth=1.4;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1150" y="1475" width="310" height="52" as="geometry"/></mxCell><mxCell id="dbcontext-title" value="«external»&#10;DbContext" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#0f172a;fontStyle=1;spacing=0;" vertex="1" parent="dbcontext"><mxGeometry x="8" y="6" width="294" height="40" as="geometry"/></mxCell><mxCell id="edge-16" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;strokeColor=#475569;strokeWidth=1.5;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="context" target="dbcontext"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290.0" y="1434.5"/><mxPoint x="1305.0" y="1434.5"/></Array></mxGeometry></mxCell><mxCell id="edge-17" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;strokeColor=#475569;strokeWidth=1.5;fontSize=13;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="context" target="conv"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1740" y="1357"/><mxPoint x="1740" y="644"/></Array></mxGeometry></mxCell><mxCell id="edge-17-label" value="model / DbSet" vertex="1" connectable="0" parent="edge-17" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#334155;fillColor=#ffffff;strokeColor=none;"><mxGeometry x="-1" y="0" width="110.2" height="21" relative="1" as="geometry"><mxPoint x="4.899999999999999" y="-130.0" as="offset"/></mxGeometry></mxCell><mxCell id="mapping" value="Mapping: Domain.Conversation.Id ↔ entity Id (GUID). Integer ConversationId / MessageId&#10;  remain database keys.&#10;StartedAt → Start and DateTime; LastActivityAt → LastUpdated; Closed ↔&#10;  ConversationStatus.Closed.&#10;ChatMessage.Role → Message.Status; Content → MessageContent; SentAt → DateTime in UTC.&#10;SenderId references the owner for Customer, Assistant and System roles; it does not&#10;  identify a separate AI user.&#10;Repository operations create / dispose their own context. SaveAsync commits atomically&#10;  and does not reopen a closed chat." style="shape=note;size=16;html=0;whiteSpace=wrap;fillColor=#fffbe8;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="1255" width="680" height="270" as="geometry"/></mxCell><mxCell id="legend" value="+ public   − private   # protected   ~ internal   / derived   «…» stereotype&#10;CT = CancellationToken; method default values and most constructors are omitted. Selected members are shown.&#10;Dashed open arrow = dependency (including «tests»); dashed hollow triangle = interface realization; solid hollow triangle = inheritance.&#10;Solid line = association; filled diamond = composition. Multiplicities are shown beside association ends." style="shape=note;size=16;html=0;whiteSpace=wrap;fillColor=#fffbe8;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1560" width="1720" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
